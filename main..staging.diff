-#!/usr/bin/env bash
-
-# mokerlink-backup: functional tests against a real Mokerlink switch.
-#
-# Copyright (C) 2025 James Hanlon [mailto:jim@hanlonsoftware.com]
-# SPDX-License-Identifier: AGPL-3.0-or-later
-#
-# These tests exercise the mokerlink-backup CLI end-to-end with no stubs.
-# Tests that require a live switch are skipped (not failed) when
-# MOKERLINK_HOST is unset or credentials are unavailable.
-#
-# Required environment (switch-dependent tests):
-#   MOKERLINK_HOST          hostname or IP of the Mokerlink switch
-#   MOKERLINK_USER          SSH username (default: remote-backup)
-#   MOKERLINK_PASSWORD      switch password, OR
-#   MOKERLINK_PASSWORD_FILE path to a file containing the password
-#
-# Usage:
-#   test/staging [options] [image]
-#   IMAGE=1121citrus/mokerlink-backup:1.2.3 test/staging
-#   test/staging --no-scan 1121citrus/mokerlink-backup:1.2.3
-#   MOKERLINK_HOST=10.0.0.1 MOKERLINK_PASSWORD=secret test/staging <image>
-#
-# Options:
-#   --image IMAGE        Docker image under test
-#   --scan               Run Trivy scan (default)
-#   --no-scan            Skip Trivy scan; implies --no-advise unless --advise is set
-#   --advise [LIST]      Run advisory scans: grype,scout,dive,all (default: grype,scout)
-#   --no-advise          Disable advisory scans
-#   --yes                Skip interactive confirmation
-#   --help|-h            Show this help and exit
-
-set -euo pipefail
-
-_SCAN="${STAGING_SCAN:-true}"
-_ADVISE_GRYPE="${STAGING_ADVISE:-true}"
-_ADVISE_SCOUT=true
-_ADVISE_DIVE=false
-_ADVISE_EXPLICIT=false
-_YES=false
-
-TRIVY_IMAGE=aquasec/trivy
-TRIVY_TAG=0.62.1
-GRYPE_IMAGE=anchore/grype
-GRYPE_TAG=v0.87.0
-DIVE_IMAGE=wagoodman/dive
-DIVE_TAG=v0.13.1
-
-TRIVY_CACHE_VOLUME=mokerlink-backup-staging-trivy-cache
-GRYPE_CACHE_VOLUME=mokerlink-backup-staging-grype-cache
-
-show_help() {
-    sed -n '/^# Usage:/,/^set -/p' "$0" \
-        | grep '^#' \
-        | sed 's/^# \{0,1\}//'
-}
-
-setup() {
-    # $1 overrides the IMAGE env var; neither has a default.
-    IMAGE="${1:-${IMAGE:-}}"
-    [[ -n "${IMAGE}" ]] || {
-        echo "ERROR: IMAGE is not set" >&2
-        echo "       Usage: test/staging <image>  or  IMAGE=<image> test/staging" >&2
-        return 1
-    }
-    docker image inspect "${IMAGE}" > /dev/null 2>&1 || {
-        echo "ERROR: image not found locally: ${IMAGE}" >&2
-        echo "       Pull or build it first: ./build --no-scan" >&2
-        return 1
-    }
-
-    # Resolve password once so each test does not re-read the file.
-    local pw_file="${MOKERLINK_PASSWORD_FILE:-"${HOME}/.secrets/mokerlink-password"}"
-    if [[ -n "${MOKERLINK_PASSWORD:-}" ]]; then
-        switch_password="${MOKERLINK_PASSWORD}"
-    elif [[ -r "${pw_file}" ]]; then
-        switch_password=$(cat "${pw_file}")
-    else
-        switch_password=
-    fi
-
-    # Run mokerlink-backup with staging credentials and the given CLI args.
-    # No stubs: the real get-config and real switch are used.
-    run_mokerlink_backup() {
-        # shellcheck disable=SC2086
-        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
-            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
-            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
-            -e "MOKERLINK_PASSWORD=${switch_password}" \
-            "${IMAGE}" /usr/local/bin/mokerlink-backup "$@" 2>/dev/null
-    }
-
-    # Verify the image contains the command before any test runs.
-    # Exit 127 from individual tests is confusing; a clear setup failure
-    # is not.  This catches a stale 'latest' image before publishing a new
-    # version — rebuild with: IMAGE=... ./build --no-scan
-    if ! docker run --rm "${IMAGE}" \
-            test -x /usr/local/bin/mokerlink-backup > /dev/null 2>&1; then
-        echo "ERROR: /usr/local/bin/mokerlink-backup not found in ${IMAGE}" >&2
-        echo "       Rebuild: ./build --no-scan" >&2
-        return 1
-    fi
-
-    # Run the legacy backup script directly with staging credentials.
-    # stderr is merged with stdout so callers capture all log output.
-    # shellcheck disable=SC2120  # "$@" is intentional: callers may pass extra docker flags
-    run_backup() {
-        local aws_mounts=()
-        [[ -r "${AWS_CONFIG_FILE:-}" ]] && \
-            aws_mounts+=(-v "${AWS_CONFIG_FILE}:/run/secrets/aws-config:ro")
-        # shellcheck disable=SC2086
-        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
-            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
-            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
-            -e "MOKERLINK_PASSWORD=${switch_password}" \
-            -e "AWS_S3_BUCKET_NAME=${AWS_S3_BUCKET_NAME:-}" \
-            -e "AWS_DRYRUN=${AWS_DRYRUN:-false}" \
-            -e "COMPRESSION=${COMPRESSION:-none}" \
-            "${aws_mounts[@]}" \
-            "$@" \
-            "${IMAGE}" /usr/local/bin/backup 2>&1
-    }
-
-    # Start the full service container (startup → crond → backup) detached.
-    # Prints the container ID to stdout; caller is responsible for stop and rm.
-    run_service_detached() {
-        local aws_mounts=()
-        [[ -r "${AWS_CONFIG_FILE:-}" ]] && \
-            aws_mounts+=(-v "${AWS_CONFIG_FILE}:/run/secrets/aws-config:ro")
-        # shellcheck disable=SC2086
-        docker run -d ${DOCKER_RUN_ARGS:-} \
-            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
-            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
-            -e "MOKERLINK_PASSWORD=${switch_password}" \
-            -e "AWS_S3_BUCKET_NAME=${AWS_S3_BUCKET_NAME:-}" \
-            -e "AWS_DRYRUN=${AWS_DRYRUN:-false}" \
-            -e "COMPRESSION=${COMPRESSION:-none}" \
-            "${aws_mounts[@]}" \
-            "$@" \
-            "${IMAGE}"
-    }
-
-    export switch_password
-    export -f run_mokerlink_backup run_backup run_service_detached
-}
-
-# _skip prints a SKIP notice and returns 0 so the test is not counted as failed.
-_skip() {
-    echo "SKIP '${FUNCNAME[1]}': $*"
-}
-
-# _switch_available returns 0 when MOKERLINK_HOST and a password are present.
-_switch_available() {
-    [[ -n "${MOKERLINK_HOST:-}" ]] && [[ -n "${switch_password:-}" ]]
-}
-
-# _aws_available returns 0 when AWS_S3_BUCKET_NAME is set and at least one
