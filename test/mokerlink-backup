test_mokerlink_backup_format_raw() {
    local output
    output=$(run_mokerlink_backup_args --running --format raw) && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero (${result})"
        return 1
    fi
    # Raw output should contain config text, not be a tar archive
    if echo "${output}" | grep -q 'System Version:'; then
        echo "PASS '${FUNCNAME[0]}': --format raw outputs config text"
    else
        echo "FAIL '${FUNCNAME[0]}': --format raw did not output config text"
        return 1
    fi
}

test_mokerlink_backup_format_invalid() {
    run_mokerlink_backup_args --format badformat > /dev/null 2>&1 \
        && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero for unknown --format value"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero for unknown --format"
        return 1
    fi
}

test_mokerlink_backup_unknown_option() {
    run_mokerlink_backup_args --no-such-option > /dev/null 2>&1 \
        && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero for unknown option"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero for unknown option"
        return 1
    fi
}

test_mokerlink_backup_all_excluded() {
    run_mokerlink_backup_args --no-running --no-startup --no-backup > /dev/null 2>&1 \
        && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero when all configs excluded"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero when all excluded"
        return 1
    fi
}

run_tests() {
    local passed=0
    local tests=(
        test_mokerlink_backup_missing_host
        test_mokerlink_backup_tailscale_fallback
        test_mokerlink_backup_missing_password
        test_mokerlink_backup_streams_tar
        test_mokerlink_backup_name_file
        test_mokerlink_backup_archive_contents
        test_mokerlink_backup_help_flag
        test_mokerlink_backup_version_flag
        test_mokerlink_backup_host_flag
        test_mokerlink_backup_running_only
        test_mokerlink_backup_startup_only
        test_mokerlink_backup_no_running_excludes
        test_mokerlink_backup_format_raw
        test_mokerlink_backup_format_invalid
        test_mokerlink_backup_unknown_option
        test_mokerlink_backup_all_excluded
    )

    setup || { echo "ERROR: Setup failed"; return 1; }

    echo "Running tests for mokerlink-backup..."
    echo "======================================"

    for test in "${tests[@]}"; do
        if "${test}"; then (( ++passed )); fi
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "======================================"
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && run_tests
