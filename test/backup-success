set -euo pipefail

setup() {
    whereami=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
    IMAGE=${IMAGE:-1121citrus/mokerlink-backup:latest}
    chmod +x "${whereami}/bin/"*

    run_backup() {
        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
            -e "PATH=/test/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
            -e AWS_S3_BUCKET_NAME=test-bucket \
            -e MOKERLINK_HOST=fake-host \
            -e MOKERLINK_PASSWORD=testpass \
            -v "${whereami}/bin:/test/bin:ro" \
            -v "${whereami}/bin/get-config:/usr/local/bin/get-config:ro" \
            -v "${whereami}/fixtures:/test/fixtures:ro" \
            "$@" \
            "${IMAGE}" /usr/local/bin/backup 2>&1
    }
    export -f run_backup
}

# Helper: assert that output contains an expected substring.
_assert_contains() {
    local description=$1 expected=$2 output=$3
    if [[ "${output}" == *"${expected}"* ]]; then
        echo "PASS '${FUNCNAME[1]}': ${description}"
    else
        echo "FAIL '${FUNCNAME[1]}': ${description} — expected '${expected}' in output"
        return 1
    fi
}

test_backup_no_compression() {
    local output
    output=$(run_backup -e COMPRESSION=none) || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    _assert_contains "begins and finishes"     "begin backup"                             "${output}"
    _assert_contains "finishes cleanly"        "finish backup"                            "${output}"
    _assert_contains "compress message"        "download 'running'"                      "${output}"
}

test_backup_zip_contents() {
    local output
    output=$(run_backup -e COMPRESSION=zip) || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    _assert_contains "zip logged" "compressing backup with zip" "${output}"
    _assert_contains "zip extension" ".zip" "${output}"
}

test_backup_bzip2_contents() {
    local output
    output=$(run_backup -e COMPRESSION=bzip2) || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    _assert_contains "bzip2 logged" "compressing backup with bzip2" "${output}"
    _assert_contains "bzip2 extension" ".bz2" "${output}"
}

test_backup_gzip_contents() {
    local output
    output=$(run_backup -e COMPRESSION=gzip) || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    _assert_contains "gzip logged" "compressing backup with gzip" "${output}"
    _assert_contains "gzip extension" ".gz" "${output}"
}

test_backup_xz_contents() {
    local output
    output=$(run_backup -e COMPRESSION=xz) || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    _assert_contains "xz logged" "compressing backup with lzma/xz" "${output}"
    _assert_contains "xz extension" ".xz" "${output}"
}

test_backup_invalid_compression() {
    run_backup -e COMPRESSION=invalid > /dev/null && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero for unsupported compression algorithm"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero"
        return 1
    fi
}

test_backup_archive_contains_configs() {
    local tmpdir
    tmpdir=$(mktemp -d)
    # Run backup with /output mounted; the aws stub copies files there
    run_backup -e COMPRESSION=none -v "${tmpdir}:/output" >/dev/null || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; rm -rf "${tmpdir}"; return 1
    }
    local tarfile
    tarfile=$(find "${tmpdir}" -name '*.tar' | head -1)
    if [[ -n "${tarfile}" ]]; then
        local contents
        contents=$(tar -tf "${tarfile}")
        local pass=true
        for config in running startup backup; do
            if echo "${contents}" | grep -q "${config}-config-backup.xml"; then
                echo "PASS '${FUNCNAME[0]}': archive contains ${config}-config-backup.xml"
            else
                echo "FAIL '${FUNCNAME[0]}': archive missing ${config}-config-backup.xml"
                pass=false
            fi
        done
        ${pass} || { rm -rf "${tmpdir}"; return 1; }
    else
        echo "FAIL '${FUNCNAME[0]}': no tar file found in output"
        rm -rf "${tmpdir}"
        return 1
    fi
    rm -rf "${tmpdir}"
}

run_tests() {
    local passed=0
    local tests=(
        test_backup_no_compression
        test_backup_zip_contents
        test_backup_bzip2_contents
        test_backup_gzip_contents
        test_backup_xz_contents
        test_backup_invalid_compression
        test_backup_archive_contains_configs
    )

    setup || { echo "ERROR: Setup failed"; return 1; }

    echo "Running tests for backup success paths..."
    echo "=========================================="

    for test in "${tests[@]}"; do
        "${test}" && ((passed++)) || :
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "=========================================="
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && run_tests
