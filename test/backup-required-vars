set -euo pipefail

setup() {
    whereami=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
    IMAGE=${IMAGE:-1121citrus/mokerlink-backup:latest}
    chmod +x "${whereami}/bin/"*

    run_backup() {
        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
            -e "PATH=/test/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
            -v "${whereami}/bin:/test/bin:ro" \
            -v "${whereami}/bin/get-config:/usr/local/bin/get-config:ro" \
            "$@" \
            "${IMAGE}" /usr/local/bin/backup 2>&1
    }
    export -f run_backup
}

test_backup_missing_bucket() {
    run_backup \
        -e MOKERLINK_HOST=fake-host \
        -e MOKERLINK_PASSWORD=foo \
        > /dev/null && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero when AWS_S3_BUCKET_NAME is unset"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero"
        return 1
    fi
}

test_backup_missing_host() {
    run_backup \
        -e AWS_S3_BUCKET_NAME=test-bucket \
        -e MOKERLINK_PASSWORD=foo \
        > /dev/null && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero when MOKERLINK_HOST and TAILSCALE_HOST are unset"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero"
        return 1
    fi
}

test_backup_missing_password() {
    run_backup \
        -e AWS_S3_BUCKET_NAME=test-bucket \
        -e MOKERLINK_HOST=fake-host \
        -e MOKERLINK_PASSWORD= \
        -e MOKERLINK_PASSWORD_FILE=/nonexistent \
        > /dev/null && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero when neither password nor password file is provided"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero"
        return 1
    fi
}

test_backup_tailscale_fallback() {
    local output
    output=$(run_backup \
        -e MOKERLINK_HOST= \
        -e TAILSCALE_HOST=tailscale-host \
        -e AWS_S3_BUCKET_NAME=test-bucket \
        -e MOKERLINK_PASSWORD=foo) && result=0 || result=$?
    if [[ ${result} -eq 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': TAILSCALE_HOST used as fallback when MOKERLINK_HOST is unset"
    else
        echo "FAIL '${FUNCNAME[0]}': should have succeeded with TAILSCALE_HOST set"
        return 1
    fi
}

test_backup_password_file() {
    local output
    output=$(run_backup \
        -e AWS_S3_BUCKET_NAME=test-bucket \
        -e MOKERLINK_HOST=fake-host \
        -e MOKERLINK_PASSWORD= \
        -e MOKERLINK_PASSWORD_FILE=/test/fixtures/gpg-passphrase \
        -v "${whereami}/fixtures:/test/fixtures:ro") && result=0 || result=$?
    if [[ ${result} -eq 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': reads password from MOKERLINK_PASSWORD_FILE"
    else
        echo "FAIL '${FUNCNAME[0]}': should have succeeded with password file"
        return 1
    fi
}

run_tests() {
    local passed=0
    local tests=(
        test_backup_missing_bucket
        test_backup_missing_host
        test_backup_missing_password
        test_backup_tailscale_fallback
        test_backup_password_file
    )

    setup || { echo "ERROR: Setup failed"; return 1; }

    echo "Running tests for backup required-variable validation..."
    echo "========================================================"

    for test in "${tests[@]}"; do
        "${test}" && ((passed++)) || :
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "========================================================"
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && run_tests
