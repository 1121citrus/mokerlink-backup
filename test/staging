#!/usr/bin/env bash

# test/staging — functional tests against a real Mokerlink switch and live AWS.
#
# Copyright (C) 2025 James Hanlon [mailto:jim@hanlonsoftware.com]
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Tests that require a live switch are skipped (not failed) when
# MOKERLINK_HOST is unset or credentials are unavailable.  Tests that require
# AWS are skipped when AWS_S3_BUCKET_NAME is unset or no credentials are found.
#
# SYNOPSIS
#   test/staging [options] [IMAGE]
#
# OPTIONS
#   IMAGE                     Docker image to test (positional; also --image)
#   --image IMAGE             Docker image to test (env: IMAGE)
#   --bucket BUCKET           S3 bucket for backup upload (env: BUCKET;
#                             also AWS_S3_BUCKET_NAME)
#   --aws-config FILE         AWS config file path
#                             (env: AWS_CONFIG_FILE;
#                             default: ~/.secrets/aws-config)
#   --aws-credentials FILE    AWS credentials file path
#                             (env: AWS_CREDENTIALS_FILE;
#                             default: ~/.secrets/aws-credentials)
#   --dryrun                  Enable dry-run; no real S3 writes
#                             (env: DRYRUN; default: true for
#                             non-test/staging buckets)
#   --no-dryrun               Disable dry-run; allow live S3 writes
#   --scan                    Run Trivy HIGH/CRITICAL scan on the image
#                             (env: STAGING_SCAN; default: true)
#   --no-scan                 Skip Trivy scan; implies --no-advise unless
#                             --advise is set explicitly
#   --advise [LIST]           Run advisory scans (default: grype,scout)
#                             Values: coverage,grype,scout,dive,all,none
#   --no-advise               Disable all advisory scans
#   --skip-e2e                Skip end-to-end backup and cron tests
#   --test TEST               Run only the named test function
#   --yes                     Skip interactive confirmation prompt
#   -h,--help                 Print this message and exit
#
# ENVIRONMENT
#   IMAGE                     Docker image to test
#   BUCKET                    S3 bucket for backup upload (alias for
#                             AWS_S3_BUCKET_NAME; service tests skipped if
#                             neither is set)
#   AWS_S3_BUCKET_NAME        S3 bucket (also settable via BUCKET)
#   AWS_CONFIG_FILE           Path to AWS config file
#                             (default: ~/.secrets/aws-config)
#   AWS_CREDENTIALS_FILE      Path to AWS credentials file
#                             (default: ~/.secrets/aws-credentials)
#   AWS_ACCESS_KEY_ID /
#   AWS_SECRET_ACCESS_KEY     Inline AWS credentials (alternative to
#                             config/credentials files)
#   DRYRUN                    true = dry-run (default for non-test/staging
#                             buckets); false = live S3 writes
#   MOKERLINK_HOST            Switch hostname or IP; switch tests skipped if
#                             unset
#   MOKERLINK_USER            SSH username (default: remote-backup)
#   MOKERLINK_PASSWORD        Switch password
#   MOKERLINK_PASSWORD_FILE   Path to switch password file
#                             (default: ~/.secrets/mokerlink-password)
#   COMPRESSION               Compression algorithm (default: none)
#   STAGING_SCAN              true/false — controls Trivy scan (default: true)
#   DOCKER_RUN_ARGS           Extra flags appended to every docker run
#                             invocation

set -euo pipefail

# Support BUCKET / DRYRUN as short aliases matching project-wide env naming.
[[ -n "${BUCKET:-}" && -z "${AWS_S3_BUCKET_NAME:-}" ]] && \
    AWS_S3_BUCKET_NAME="${BUCKET}"
[[ -n "${DRYRUN:-}" ]] && AWS_DRYRUN="${DRYRUN}"

_BUCKET=
_AWS_CONFIG=
_AWS_CREDENTIALS=
_DRYRUN=
_SKIP_E2E=false
_TEST_FILTER=
_SCAN="${STAGING_SCAN:-true}"
_ADVISE_COVERAGE=false
_ADVISE_GRYPE="${STAGING_ADVISE:-true}"
_ADVISE_SCOUT=true
_ADVISE_DIVE=false
_ADVISE_EXPLICIT=false
_YES=false

TRIVY_IMAGE=aquasec/trivy
TRIVY_TAG=0.62.1
GRYPE_IMAGE=anchore/grype
GRYPE_TAG=v0.87.0
DIVE_IMAGE=wagoodman/dive
DIVE_TAG=v0.13.1
BATS_KCOV_IMAGE=1121citrus/bats-kcov
BATS_KCOV_TAG=latest

TRIVY_CACHE_VOLUME=mokerlink-backup-staging-trivy-cache
GRYPE_CACHE_VOLUME=mokerlink-backup-staging-grype-cache

show_help() {
    sed -n '/^# SYNOPSIS/,/^[^#]/p' "$0" \
        | grep '^#' \
        | sed 's/^# \{0,1\}//'
}

setup() {
    # $1 overrides the IMAGE env var; neither has a default.
    IMAGE="${1:-${IMAGE:-}}"
    [[ -n "${IMAGE}" ]] || {
        echo "ERROR: IMAGE is not set" >&2
        echo "       Usage: test/staging <image>  or  IMAGE=<image> test/staging" >&2
        return 1
    }
    docker image inspect "${IMAGE}" > /dev/null 2>&1 || {
        echo "ERROR: image not found locally: ${IMAGE}" >&2
        echo "       Pull or build it first: ./build --no-scan" >&2
        return 1
    }

    # Resolve password once so each test does not re-read the file.
    local pw_file="${MOKERLINK_PASSWORD_FILE:-"${HOME}/.secrets/mokerlink-password"}"
    if [[ -n "${MOKERLINK_PASSWORD:-}" ]]; then
        switch_password="${MOKERLINK_PASSWORD}"
    elif [[ -r "${pw_file}" ]]; then
        switch_password=$(cat "${pw_file}")
    else
        switch_password=
    fi

    # Run mokerlink-backup with staging credentials and the given CLI args.
    # No stubs: the real get-config and real switch are used.
    run_mokerlink_backup() {
        # shellcheck disable=SC2086
        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
            -e "MOKERLINK_PASSWORD=${switch_password}" \
            "${IMAGE}" /usr/local/bin/mokerlink-backup "$@" 2>/dev/null
    }

    # Verify the image contains the command before any test runs.
    # Exit 127 from individual tests is confusing; a clear setup failure
    # is not.  This catches a stale 'latest' image before publishing a new
    # version — rebuild with: IMAGE=... ./build --no-scan
    if ! docker run --rm "${IMAGE}" \
            test -x /usr/local/bin/mokerlink-backup > /dev/null 2>&1; then
        echo "ERROR: /usr/local/bin/mokerlink-backup not found in ${IMAGE}" >&2
        echo "       Rebuild: ./build --no-scan" >&2
        return 1
    fi

    # Run the backup script directly with staging credentials.
    # stderr is merged with stdout so callers capture all log output.
    # shellcheck disable=SC2120  # "$@" is intentional: callers may pass extra docker flags
    run_backup() {
        local aws_mounts=() aws_env=()
        [[ -r "${AWS_CONFIG_FILE:-}" ]] && \
            aws_mounts+=(-v "${AWS_CONFIG_FILE}:/run/secrets/aws-config:ro")
        [[ -r "${AWS_CREDENTIALS_FILE:-}" ]] && {
            aws_mounts+=(-v "${AWS_CREDENTIALS_FILE}:/run/secrets/aws-credentials:ro")
            aws_env+=(-e "AWS_SHARED_CREDENTIALS_FILE=/run/secrets/aws-credentials")
        }
        # shellcheck disable=SC2086
        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
            -e "MOKERLINK_PASSWORD=${switch_password}" \
            -e "AWS_S3_BUCKET_NAME=${AWS_S3_BUCKET_NAME:-}" \
            -e "AWS_DRYRUN=${AWS_DRYRUN:-false}" \
            -e "COMPRESSION=${COMPRESSION:-none}" \
            "${aws_mounts[@]}" \
            "${aws_env[@]}" \
            "$@" \
            "${IMAGE}" /usr/local/bin/backup 2>&1
    }

    # Start the full service container (startup → crond → backup) detached.
    # Prints the container ID to stdout; caller is responsible for stop and rm.
    run_service_detached() {
        local aws_mounts=() aws_env=()
        [[ -r "${AWS_CONFIG_FILE:-}" ]] && \
            aws_mounts+=(-v "${AWS_CONFIG_FILE}:/run/secrets/aws-config:ro")
        [[ -r "${AWS_CREDENTIALS_FILE:-}" ]] && {
            aws_mounts+=(-v "${AWS_CREDENTIALS_FILE}:/run/secrets/aws-credentials:ro")
            aws_env+=(-e "AWS_SHARED_CREDENTIALS_FILE=/run/secrets/aws-credentials")
        }
        # shellcheck disable=SC2086
        docker run -d ${DOCKER_RUN_ARGS:-} \
            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
            -e "MOKERLINK_PASSWORD=${switch_password}" \
            -e "AWS_S3_BUCKET_NAME=${AWS_S3_BUCKET_NAME:-}" \
            -e "AWS_DRYRUN=${AWS_DRYRUN:-false}" \
            -e "COMPRESSION=${COMPRESSION:-none}" \
            "${aws_mounts[@]}" \
            "${aws_env[@]}" \
            "$@" \
            "${IMAGE}"
    }

    export switch_password
    export -f run_mokerlink_backup run_backup run_service_detached
}

# _skip prints a SKIP notice and returns 0 so the test is not counted as failed.
_skip() {
    echo "SKIP '${FUNCNAME[1]}': $*"
}

# _switch_available returns 0 when MOKERLINK_HOST and a password are present.
_switch_available() {
    [[ -n "${MOKERLINK_HOST:-}" ]] && [[ -n "${switch_password:-}" ]]
}

# _aws_available returns 0 when AWS_S3_BUCKET_NAME is set and at least one
# form of AWS credentials is present.
_aws_available() {
    [[ -n "${AWS_S3_BUCKET_NAME:-}" ]] && {
        [[ -r "${AWS_CONFIG_FILE:-/run/secrets/aws-config}" ]] || \
        [[ -r "${AWS_CREDENTIALS_FILE:-}" ]]            || \
        [[ -n "${AWS_ACCESS_KEY_ID:-}" ]]
    }
}

# _service_available returns 0 when both switch and AWS are configured.
_service_available() {
    _switch_available && _aws_available
}

# ── Switch-independent tests ──────────────────────────────────────────────────
# These exercise CLI option parsing only; no switch connection is attempted.

test_staging_help() {
    local output
    output=$(run_mokerlink_backup --help 2>&1) && result=0 || result=$?
    if [[ ${result} -eq 0 ]] && echo "${output}" | grep -q 'Usage:'; then
        echo "PASS '${FUNCNAME[0]}': --help exits 0 and prints usage"
    else
        echo "FAIL '${FUNCNAME[0]}': --help failed (exit=${result})"
        return 1
    fi
}

