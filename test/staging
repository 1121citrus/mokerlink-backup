# ── Cron / service-mode tests ─────────────────────────────────────────────────
# Both tests require switch access AND AWS credentials.
# Set AWS_DRYRUN=true to exercise the full pipeline without real S3 writes.

# test_staging_backup_direct: run the `backup` script once, directly.
# Verifies the full mokerlink-backup → compress → (encrypt) → S3 pipeline.
# Expected duration: 30–90 s depending on switch response and compression.
test_staging_backup_direct() {
    _service_available || { _skip "switch or AWS not configured"; return 0; }

    printf '  starting backup (AWS_DRYRUN=%s; may take up to 2m)...\n' \
        "${AWS_DRYRUN:-false}" >&2

    local tmpfile result=0 elapsed=0
    tmpfile=$(mktemp)
    run_backup > "${tmpfile}" 2>&1 &
    local bgpid=$!
    while kill -0 "${bgpid}" 2>/dev/null; do
        sleep 10
        elapsed=$(( elapsed + 10 ))
        printf '  [%ds] backup in progress...\n' "${elapsed}" >&2
    done
    wait "${bgpid}" && result=0 || result=$?

    local output
    output=$(cat "${tmpfile}")
    rm -f "${tmpfile}"

    if [[ ${result} -ne 0 ]]; then
        echo "FAIL '${FUNCNAME[0]}': backup exited non-zero (${result})"
        printf '%s\n' "${output}" | tail -5 >&2
        return 1
    fi
    if echo "${output}" | grep -q 'finish backup'; then
        echo "PASS '${FUNCNAME[0]}': backup completed in ${elapsed}s (AWS_DRYRUN=${AWS_DRYRUN:-false})"
    else
        echo "FAIL '${FUNCNAME[0]}': 'finish backup' not found in output"
        printf '%s\n' "${output}" | tail -5 >&2
        return 1
    fi
}

# test_staging_cron_fires: start the full service container and wait for the
# cron daemon to trigger a complete backup cycle.
# Expected duration: up to 4 m (≤60 s to first cron tick + backup run time).
test_staging_cron_fires() {
    _service_available || { _skip "switch or AWS not configured"; return 0; }

    # Schedule every minute so the first fire is at most 60 s away.
    local container_id
    container_id=$(run_service_detached -e "CRON_EXPRESSION=* * * * *")
    printf '  container %s started; waiting for first cron backup (up to 4m)...\n' \
        "${container_id:0:12}" >&2

    local elapsed=0 timeout=240 interval=10 found=false last_log
    while [[ ${elapsed} -lt ${timeout} ]]; do
        sleep "${interval}"
        elapsed=$(( elapsed + interval ))
        if docker logs "${container_id}" 2>&1 | grep -q 'finish backup'; then
            found=true
            break
        fi
        last_log=$(docker logs --tail 1 "${container_id}" 2>&1)
        printf '  [%ds] waiting... (last: %s)\n' "${elapsed}" "${last_log}" >&2
    done

    docker stop "${container_id}" > /dev/null 2>&1
    docker rm   "${container_id}" > /dev/null 2>&1

    if "${found}"; then
        echo "PASS '${FUNCNAME[0]}': cron backup completed within ${elapsed}s (AWS_DRYRUN=${AWS_DRYRUN:-false})"
    else
        echo "FAIL '${FUNCNAME[0]}': backup did not complete within ${timeout}s"
        return 1
    fi
}

run_tests() {
    local passed=0
    local _unit_tests=(
        test_staging_help
        test_staging_version
        test_staging_unknown_option
        test_staging_format_invalid
        test_staging_all_excluded
        test_staging_default_tar
        test_staging_running_only
        test_staging_startup_only
        test_staging_backup_only
        test_staging_no_running
        test_staging_format_raw
        test_staging_name_file
    )
    local _e2e_tests=(
        test_staging_backup_direct
        test_staging_cron_fires
    )

    local tests=()
    if [[ -n "${_TEST_FILTER}" ]]; then
        tests=("${_TEST_FILTER}")
    elif [[ "${_SKIP_E2E}" == "true" ]]; then
        tests=("${_unit_tests[@]}")
    else
        tests=("${_unit_tests[@]}" "${_e2e_tests[@]}")
    fi

    setup "${@}" || { echo "ERROR: Setup failed"; return 1; }

    echo "Running staging tests for mokerlink-backup..."
    echo "=============================================="
    echo "Scans: Trivy=${_SCAN} Grype=${_ADVISE_GRYPE} Scout=${_ADVISE_SCOUT} Dive=${_ADVISE_DIVE} Coverage=${_ADVISE_COVERAGE}"
    echo "=============================================="

    if [[ "${_SCAN}" == "true" ]]; then
        echo "==> Scan: Trivy ${IMAGE}" >&2
        _trivy_tar=$(mktemp /tmp/trivy-scan-XXXXXX)
        trap 'rm -f "${_trivy_tar}"' EXIT
        docker image save "${IMAGE}" -o "${_trivy_tar}"
        docker run --rm \
            -v "${_trivy_tar}:/scan.tar:ro" \
            -v "${TRIVY_CACHE_VOLUME}:/root/.cache/trivy" \
            "${TRIVY_IMAGE}:${TRIVY_TAG}" image \
                --exit-code 1 \
                --ignore-unfixed \
                --severity HIGH,CRITICAL \
                --input /scan.tar
        rm -f "${_trivy_tar}"
        trap - EXIT
    fi

    if [[ "${_ADVISE_GRYPE}" == "true" ]]; then
        echo "==> Advise: Grype ${IMAGE}" >&2
        _staging_grype_vol=()
        _staging_grype_cfg=()
        _staging_script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
        if [[ -f "${_staging_script_dir}/.grype.yaml" ]]; then
            _staging_grype_vol=(-v "${_staging_script_dir}/.grype.yaml:/.grype.yaml:ro")
            _staging_grype_cfg=(--config /.grype.yaml)
        fi
        _grype_tar=$(mktemp /tmp/grype-scan-XXXXXX)
        trap 'rm -f "${_grype_tar}"' EXIT
        docker image save "${IMAGE}" -o "${_grype_tar}"
        docker run --rm \
            -v "${_grype_tar}:/scan.tar:ro" \
            -v "${GRYPE_CACHE_VOLUME}:/root/.cache/grype" \
            "${_staging_grype_vol[@]}" \
            "${GRYPE_IMAGE}:${GRYPE_TAG}" \
                "${_staging_grype_cfg[@]}" \
                docker-archive:/scan.tar || true
        rm -f "${_grype_tar}"
        trap - EXIT
    fi

    if [[ "${_ADVISE_SCOUT}" == "true" ]]; then
        echo "==> Advise: Scout ${IMAGE}" >&2
        docker scout cves "${IMAGE}" || true
    fi

    if [[ "${_ADVISE_DIVE}" == "true" ]]; then
        echo "==> Advise: Dive ${IMAGE}" >&2
        _dive_tar=$(mktemp /tmp/dive-scan-XXXXXX)
        trap 'rm -f "${_dive_tar}"' EXIT
        docker save "${IMAGE}" > "${_dive_tar}"
        docker run --rm \
            -v "${_dive_tar}:/scan.tar:ro" \
            "${DIVE_IMAGE}:${DIVE_TAG}" \
                --source docker-archive \
                --ci \
                /scan.tar || true
        rm -f "${_dive_tar}"
        trap - EXIT
    fi

    if [[ "${_ADVISE_COVERAGE}" == "true" ]]; then
        echo "==> Advise: Coverage" >&2
        _coverage_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
        docker run --rm \
            --cap-add SYS_PTRACE \
            --security-opt seccomp=unconfined \
            -v "${_coverage_root}:/code:ro" \
            -w /code \
            "${BATS_KCOV_IMAGE}:${BATS_KCOV_TAG}" \
            bats-coverage \
                test/01-build.bats \
                test/02-mokerlink-backup.bats \
                test/03-backup-required-vars.bats \
                test/04-backup-success.bats \
                test/05-backup-encryption.bats \
                test/06-healthcheck.bats \
                test/07-image-metadata.bats \
                test/08-startup.bats \
            >&2 || echo "    Coverage run failed (advisory only)" >&2
    fi

    echo "=============================================="
    if _switch_available; then
        echo "Switch: ${MOKERLINK_HOST} (user: ${MOKERLINK_USER:-remote-backup})"
    else
        echo "Switch: not configured — switch-dependent tests will be skipped"
    fi
    echo "=============================================="

    for test in "${tests[@]}"; do
        if "${test}"; then (( ++passed )); fi
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "=============================================="
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

main() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --image)
                IMAGE="$2"; shift
                ;;
            --bucket)
                [[ $# -ge 2 ]] || { echo "option '${1}' requires an argument" >&2; exit 1; }
                _BUCKET="$2"; shift
                ;;
            --aws-config)
                [[ $# -ge 2 ]] || { echo "option '${1}' requires an argument" >&2; exit 1; }
                _AWS_CONFIG="$2"; shift
                ;;
            --aws-credentials)
                [[ $# -ge 2 ]] || { echo "option '${1}' requires an argument" >&2; exit 1; }
                _AWS_CREDENTIALS="$2"; shift
                ;;
            --dryrun)
                _DRYRUN=true
                ;;
            --no-dryrun)
                _DRYRUN=false
                ;;
            --skip-e2e)
                _SKIP_E2E=true
                ;;
            --test)
                [[ $# -ge 2 ]] || { echo "option '${1}' requires an argument" >&2; exit 1; }
                _TEST_FILTER="$2"; shift
                ;;
            --scan)
                _SCAN=true
                ;;
            --no-scan)
                _SCAN=false
                ;;
            --advise|--advice)
                _ADVISE_EXPLICIT=true
                if [[ $# -gt 1 && ! "$2" =~ ^-- ]]; then
                    advisements="$2"
                    shift
                else
                    advisements="grype,scout"
                fi
                _ADVISE_COVERAGE=false
                _ADVISE_GRYPE=false
                _ADVISE_SCOUT=false
                _ADVISE_DIVE=false
                IFS=',' read -ra adv_list <<< "$advisements"
                for adv in "${adv_list[@]}"; do
                    case "$adv" in
                        coverage) _ADVISE_COVERAGE=true ;;
                        grype)    _ADVISE_GRYPE=true ;;
                        scout)    _ADVISE_SCOUT=true ;;
                        dive)     _ADVISE_DIVE=true ;;
                        all)      _ADVISE_COVERAGE=true; _ADVISE_GRYPE=true; _ADVISE_SCOUT=true; _ADVISE_DIVE=true ;;
                        *)        echo "Unknown advisement: $adv" >&2; exit 1 ;;
                    esac
                done
                ;;
            --no-advise)
                _ADVISE_EXPLICIT=true
                _ADVISE_COVERAGE=false
                _ADVISE_GRYPE=false
                _ADVISE_SCOUT=false
                _ADVISE_DIVE=false
                ;;
            --yes)
                _YES=true
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            -*)
                echo "Unknown option: $1" >&2
                exit 1
                ;;
            *)
                if [[ -z "${IMAGE:-}" ]]; then
                    IMAGE="$1"
                else
                    echo "Unexpected argument: $1" >&2
                    exit 1
                fi
                ;;
        esac
        shift
    done

    if [[ "${_SCAN}" == "false" && "${_ADVISE_EXPLICIT}" == "false" ]]; then
        _ADVISE_COVERAGE=false
        _ADVISE_GRYPE=false
        _ADVISE_SCOUT=false
        _ADVISE_DIVE=false
    fi

    # Apply CLI overrides.
    [[ -n "${_BUCKET}" ]]          && AWS_S3_BUCKET_NAME="${_BUCKET}"
    [[ -n "${_AWS_CONFIG}" ]]      && AWS_CONFIG_FILE="${_AWS_CONFIG}"
    [[ -n "${_AWS_CREDENTIALS}" ]] && AWS_CREDENTIALS_FILE="${_AWS_CREDENTIALS}"
    [[ -n "${_DRYRUN}" ]]          && AWS_DRYRUN="${_DRYRUN}"

    # ── Preflight: evaluate what will actually be touched ─────────────────────
    local image="${IMAGE:-<not set>}"
    local bucket="${AWS_S3_BUCKET_NAME:-}"
    local pw_file="${MOKERLINK_PASSWORD_FILE:-"${HOME}/.secrets/mokerlink-password"}"
    local aws_cfg="${AWS_CONFIG_FILE:-"${HOME}/.secrets/aws-config"}"
    local aws_creds="${AWS_CREDENTIALS_FILE:-"${HOME}/.secrets/aws-credentials"}"

    local will_touch_switch=false will_touch_aws=false
    [[ -n "${MOKERLINK_HOST:-}" ]] && \
        { [[ -n "${MOKERLINK_PASSWORD:-}" ]] || [[ -r "${pw_file}" ]]; } && \
        will_touch_switch=true
    [[ -n "${bucket}" ]] && \
        { [[ -r "${aws_cfg}" ]] || [[ -r "${aws_creds}" ]] || \
          [[ -n "${AWS_ACCESS_KEY_ID:-}" ]]; } && \
        will_touch_aws=true

    # ── Warning header ────────────────────────────────────────────────────────
    echo "================================================================"
    echo " WARNING: test/staging exercises live infrastructure"
    echo "================================================================"
    echo ""
    echo "  Image:    ${image}"
    echo ""

    if "${will_touch_switch}"; then
        echo "  Switch:   ${MOKERLINK_HOST}" \
             "(user: ${MOKERLINK_USER:-remote-backup})"
        echo "            SSH sessions will be opened to this host."
    else
        echo "  Switch:   not configured — switch tests will be skipped"
    fi
    echo ""

    # ── Bucket safety check (may override AWS_DRYRUN) ────────────────────────
    # For buckets that do not look like test or staging, default to dry-run
    # to prevent accidental production writes.  AWS_DRYRUN=false overrides.
    local caution_bucket=false
    if [[ -n "${bucket}" ]] && \
       [[ "${bucket}" != test.* ]] && \
       [[ "${bucket}" != staging.* ]]; then
        caution_bucket=true
        if [[ "${AWS_DRYRUN:-}" != "false" ]]; then
            AWS_DRYRUN=true
            export AWS_DRYRUN
        fi
    fi

    if "${will_touch_aws}"; then
        echo "  S3:       s3://${bucket}"
        [[ -r "${aws_cfg}" ]]   && echo "  Config:   ${aws_cfg}"
        [[ -r "${aws_creds}" ]] && echo "  Creds:    ${aws_creds}"
        if [[ "${AWS_DRYRUN:-false}" == "true" ]]; then
            echo "  Dry-run:  true — no files will be written to S3"
        else
            echo "  Dry-run:  false — FILES WILL BE WRITTEN TO THIS BUCKET"
        fi
    else
        echo "  S3:       not configured — service tests will be skipped"
    fi
    [[ "${_SKIP_E2E}" == "true" ]] && echo "  Skip e2e: true"
    [[ -n "${_TEST_FILTER}" ]]     && echo "  Filter:   ${_TEST_FILTER}"
    echo ""

    if "${caution_bucket}"; then
        echo "  !! CAUTION !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "  !! AWS_S3_BUCKET_NAME='${bucket}'"
        echo "  !! does not start with 'test.' or 'staging.'."
        if [[ "${AWS_DRYRUN:-false}" == "true" ]]; then
            echo "  !! AWS_DRYRUN forced to 'true'."
            echo "  !! Set AWS_DRYRUN=false to allow real S3 writes."
        else
            echo "  !! AWS_DRYRUN=false: real files WILL be written to S3."
        fi
        echo "  !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo ""
    fi

    # ── Confirmation ──────────────────────────────────────────────────────────
    # Prompt only when real systems would be touched; default is to abort.
    if [[ "${_YES}" != "true" ]] && { "${will_touch_switch}" || "${will_touch_aws}"; }; then
        printf 'Type "yes" to proceed, or press Enter to abort: '
        local response
        read -r response
        echo ""
        if [[ "${response}" != "yes" ]]; then
            echo "Aborted."
            return 1
        fi
    fi

    run_tests "$@"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && main "$@"
