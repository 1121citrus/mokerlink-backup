#
# These tests exercise the mokerlink-backup CLI end-to-end with no stubs.
# Tests that require a live switch are skipped (not failed) when
# MOKERLINK_HOST is unset or credentials are unavailable.
#
# Required environment (switch-dependent tests):
#   MOKERLINK_HOST          hostname or IP of the Mokerlink switch
#   MOKERLINK_USER          SSH username (default: remote-backup)
#   MOKERLINK_PASSWORD      switch password, OR
#   MOKERLINK_PASSWORD_FILE path to a file containing the password
#
# Usage:
#   IMAGE=1121citrus/mokerlink-backup:1.2.3 test/staging
#   MOKERLINK_HOST=10.0.0.1 MOKERLINK_PASSWORD=secret test/staging

set -euo pipefail

setup() {
    IMAGE=${IMAGE:-1121citrus/mokerlink-backup:latest}

    # Resolve password once so each test does not re-read the file.
    local pw_file="${MOKERLINK_PASSWORD_FILE:-/run/secrets/mokerlink-password}"
    if [[ -n "${MOKERLINK_PASSWORD:-}" ]]; then
        switch_password="${MOKERLINK_PASSWORD}"
    elif [[ -r "${pw_file}" ]]; then
        switch_password=$(cat "${pw_file}")
    else
        switch_password=
    fi

    # Run mokerlink-backup with staging credentials and the given CLI args.
    # No stubs: the real get-config and real switch are used.
    run_mokerlink_backup() {
        # shellcheck disable=SC2086
        docker run -i --rm ${DOCKER_RUN_ARGS:-} \
            -e "MOKERLINK_HOST=${MOKERLINK_HOST:-}" \
            -e "MOKERLINK_USER=${MOKERLINK_USER:-remote-backup}" \
            -e "MOKERLINK_PASSWORD=${switch_password}" \
            "${IMAGE}" /usr/local/bin/mokerlink-backup "$@" 2>/dev/null
    }

    export switch_password
    export -f run_mokerlink_backup
}

# _skip prints a SKIP notice and returns 0 so the test is not counted as failed.
_skip() {
    echo "SKIP '${FUNCNAME[1]}': $*"
}

# _switch_available returns 0 when MOKERLINK_HOST and a password are present.
_switch_available() {
    [[ -n "${MOKERLINK_HOST:-}" ]] && [[ -n "${switch_password:-}" ]]
}

# ── Switch-independent tests ──────────────────────────────────────────────────
# These exercise CLI option parsing only; no switch connection is attempted.

test_staging_help() {
    local output
    output=$(run_mokerlink_backup --help 2>&1) && result=0 || result=$?
    if [[ ${result} -eq 0 ]] && echo "${output}" | grep -q 'Usage:'; then
        echo "PASS '${FUNCNAME[0]}': --help exits 0 and prints usage"
    else
        echo "FAIL '${FUNCNAME[0]}': --help failed (exit=${result})"
        return 1
    fi
}

test_staging_version() {
    local output
    output=$(run_mokerlink_backup --version 2>&1) && result=0 || result=$?
    if [[ ${result} -eq 0 ]] && [[ -n "${output}" ]]; then
        echo "PASS '${FUNCNAME[0]}': --version exits 0 and prints: ${output}"
    else
        echo "FAIL '${FUNCNAME[0]}': --version failed (exit=${result})"
        return 1
    fi
}

test_staging_unknown_option() {
    run_mokerlink_backup --no-such-option > /dev/null 2>&1 \
        && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero for unknown option"
    else
        echo "FAIL '${FUNCNAME[0]}': should have exited non-zero"
        return 1
    fi
}

test_staging_format_invalid() {
    run_mokerlink_backup --format badformat > /dev/null 2>&1 \
        && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': exits non-zero for invalid --format value"
    else
