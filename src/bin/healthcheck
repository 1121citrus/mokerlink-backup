#!/usr/bin/env bash

# healthcheck — verify supercronic is running, the crontab is installed, and the
# last backup succeeded within the configured maximum age.
#
# Copyright (C) 2025 James Hanlon [mailto:jim@hanlonsoftware.com]
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# ENVIRONMENT
#   BACKUP_SENTINEL_FILE   Path to the sentinel file written by `backup` on
#                          success (default: /tmp/mokerlink-backup-last-success)
#   BACKUP_MAX_AGE_SECONDS Maximum acceptable age of the sentinel file in
#                          seconds (default: 172800 = 2 days).  If the
#                          sentinel is older than this, healthcheck exits 1.
#   DEBUG                  Enable debug tracing (default: false)
#   ENV                    Env-file path (default: ~/.env)

bindir=$(readlink -f "$(dirname "${0}")")
export PATH=${bindir}:${PATH}

# shellcheck disable=SC1091
source /usr/local/include/bash/common-functions

# startup writes ENV so healthcheck and backup share the same configuration.
ENV=${ENV:-${HOME:-/root}/.env}
# shellcheck disable=SC1090
[[ -r "${ENV}" ]] && source "${ENV}"

set -o errexit -o errtrace -o nounset -o pipefail
is_true "${DEBUG:-false}" && set -o xtrace -o verbose

function has_cronjob_run() {
    local sentinel="${BACKUP_SENTINEL_FILE:-/tmp/mokerlink-backup-last-success}"
    # No sentinel yet: backup has not run since the container started.
    # Treat as healthy — the first run is pending.
    [[ -f "${sentinel}" ]] || return 0
    local max_age="${BACKUP_MAX_AGE_SECONDS:-172800}"
    local now mtime age
    now=$(date +%s)
    mtime=$(stat -c '%Y' "${sentinel}")
    age=$(( now - mtime ))
    if [[ "${age}" -gt "${max_age}" ]]; then
        error "last successful backup is ${age}s old (BACKUP_MAX_AGE_SECONDS=${max_age})"
    fi
}

function is_crond_running() {
    # pidof is provided by busybox on Alpine; pgrep (procps) is the fallback
    # for images where pidof is absent or restricted.
    if pidof supercronic >/dev/null 2>&1; then
        return 0
    elif pgrep -q supercronic; then
        return 0
    else
        error supercronic is not running
    fi
}

function is_crontab_configured() {
    local crontab_file
    crontab_file="/var/spool/cron/crontabs/$(id -un)"
    if [[ -f "${crontab_file}" ]] && grep -q '/backup' "${crontab_file}"; then
        return 0
    else
        error crontab is not configured
    fi
}

function is_healthy() {
    is_crontab_configured && is_crond_running && has_cronjob_run
}

is_healthy || exit 1
