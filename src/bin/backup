#!/usr/bin/env bash

# backup — download a Mokerlink switch configuration and upload it to S3.
#
# Copyright (C) 2025 James Hanlon [mailto:jim@hanlonsoftware.com]
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# SYNOPSIS
#   backup [options]
#
# OPTIONS
#   -?,--help              Display this help text
#   -v,--version           Display command version
#   --host HOST            Switch hostname or IP (env: MOKERLINK_HOST)
#   --user USER            SSH username (env: MOKERLINK_USER;
#                          default: remote-backup)
#   --password PW          Switch password (env: MOKERLINK_PASSWORD;
#                          prefer --password-file)
#   --password-file FILE   Path to switch password file
#                          (env: MOKERLINK_PASSWORD_FILE;
#                          default: /run/secrets/mokerlink-password)
#   --bucket BUCKET        S3 bucket name (env: AWS_S3_BUCKET_NAME)
#   --aws-config FILE      AWS config file (env: AWS_CONFIG_FILE;
#                          default: /run/secrets/aws-config)
#   --aws-certificate FILE Custom CA certificate bundle for AWS API calls
#                          (env: AWS_CA_BUNDLE)
#   --gpg-passphrase PW    GPG encryption passphrase (env: GPG_PASSPHRASE;
#                          prefer --gpg-passphrase-file)
#   --gpg-passphrase-file FILE
#                          Path to GPG passphrase file (env: GPG_PASSPHRASE_FILE;
#                          default: /run/secrets/gpg-passphrase)
#   --dryrun               Dry-run S3 operations (env: AWS_DRYRUN=true)
#
# ENVIRONMENT
#   MOKERLINK_HOST         Switch hostname or IP (required unless --host given)
#   MOKERLINK_USER         SSH username (default: remote-backup)
#   MOKERLINK_PASSWORD     Switch password (prefer MOKERLINK_PASSWORD_FILE)
#   MOKERLINK_PASSWORD_FILE
#                          Path to switch password file
#                          (default: /run/secrets/mokerlink-password)
#   AWS_S3_BUCKET_NAME     S3 bucket name (required unless --bucket given)
#   AWS_CONFIG_FILE        AWS config file (default: /run/secrets/aws-config)
#   AWS_CA_BUNDLE          Custom CA certificate bundle path
#   AWS_DRYRUN             Set 'true' to skip real S3 writes (default: false)
#   COMPRESSION            Compression algorithm (default: none)
#                          One of: bzip2, bzip3, gz, lzo, lzma, none,
#                          pigz, pixz, xz, zip
#   GPG_PASSPHRASE         GPG passphrase for symmetric encryption
#   GPG_PASSPHRASE_FILE    Path to GPG passphrase file
#                          (default: /run/secrets/gpg-passphrase)
#   DEBUG                  Enable debug tracing (default: false)
#   ENV                    Env-file path (default: ~/.env)

command=$(basename "${0}")
bindir=$(readlink -f "$(dirname "${0}")")
export PATH=${bindir}:${PATH}

# shellcheck disable=SC1091
source /usr/local/include/bash/common-functions

ENV=${ENV:-${HOME:-/root}/.env}
set -o errexit -o errtrace -o nounset -o pipefail
# shellcheck disable=SC1090
[[ -r "${ENV}" ]] && source "${ENV}"
is_true "${DEBUG:=false}" && set -o xtrace -o verbose

show_help() {
    sed -n '/^# SYNOPSIS/,/^[^#]/p' "$0" \
        | grep '^#' \
        | sed 's/^# \{0,1\}//'
}

show_version() {
    cat /usr/local/share/mokerlink-backup/version 2>/dev/null || echo "unknown"
}

# Parse CLI arguments; overrides corresponding environment variables.
_cli_host=
_cli_user=
_cli_password=
_cli_password_file=
_cli_bucket=
_cli_aws_config=
_cli_aws_cert=
_cli_gpg_passphrase=
_cli_gpg_passphrase_file=
_cli_dryrun=

while [[ $# -gt 0 ]]; do
    case "$1" in
        -\?|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        --host)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_host="$2"; shift
            ;;
        --user)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_user="$2"; shift
            ;;
        --password)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_password="$2"; shift
            ;;
        --password-file)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_password_file="$2"; shift
            ;;
        --bucket)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_bucket="$2"; shift
            ;;
        --aws-config)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_aws_config="$2"; shift
            ;;
        --aws-certificate)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_aws_cert="$2"; shift
            ;;
        --gpg-passphrase)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_gpg_passphrase="$2"; shift
            ;;
        --gpg-passphrase-file)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            _cli_gpg_passphrase_file="$2"; shift
            ;;
        --dryrun|--dry-run)
            _cli_dryrun=true
            ;;
        --)
            shift; break
            ;;
        -*)
            error "unknown option: '${1}'"
            ;;
        *)
            error "unexpected argument: '${1}'"
            ;;
    esac
    shift
done

# Apply CLI overrides to environment variables.
[[ -n "${_cli_host}" ]]               && export MOKERLINK_HOST="${_cli_host}"
[[ -n "${_cli_user}" ]]               && export MOKERLINK_USER="${_cli_user}"
[[ -n "${_cli_password}" ]]           && export MOKERLINK_PASSWORD="${_cli_password}"
[[ -n "${_cli_password_file}" ]]      && export MOKERLINK_PASSWORD_FILE="${_cli_password_file}"
[[ -n "${_cli_bucket}" ]]             && AWS_S3_BUCKET_NAME="${_cli_bucket}"
[[ -n "${_cli_aws_config}" ]]         && AWS_CONFIG_FILE="${_cli_aws_config}"
[[ -n "${_cli_aws_cert}" ]]           && AWS_CA_BUNDLE="${_cli_aws_cert}"
[[ -n "${_cli_dryrun}" ]]             && AWS_DRYRUN="${_cli_dryrun}"
[[ -n "${_cli_gpg_passphrase}" ]]     && GPG_PASSPHRASE="${_cli_gpg_passphrase}"
[[ -n "${_cli_gpg_passphrase_file}" ]] && GPG_PASSPHRASE_FILE="${_cli_gpg_passphrase_file}"

# Export AWS config and optional CA bundle; AWS CLI picks them up automatically.
export AWS_CONFIG_FILE="${AWS_CONFIG_FILE:-/run/secrets/aws-config}"
[[ -n "${AWS_CA_BUNDLE:-}" ]] && export AWS_CA_BUNDLE

bucket="${AWS_S3_BUCKET_NAME:-}"
[[ -n "${bucket}" ]] || error 'need AWS_S3_BUCKET_NAME or --bucket'
dryrun="${AWS_DRYRUN:-false}"

gpg_encrypt=false
gpg_args=(--symmetric --cipher-algo "${GPG_CIPHER_ALGO:=aes256}" --batch)
if [[ -n "${GPG_PASSPHRASE:-}" ]]; then
    # Use passphrase-fd to avoid exposing passphrase in process list (argv)
    gpg_args+=(--passphrase-fd 3)
    gpg_encrypt=true
elif [[ -r "${GPG_PASSPHRASE_FILE:=/run/secrets/gpg-passphrase}" ]]; then
    gpg_args+=(--passphrase-file "${GPG_PASSPHRASE_FILE}")
    gpg_encrypt=true
fi

info "begin ${command}"

# Create a work directory for compression, encryption, and upload staging.
workdir=$(mktemp -d)
# shellcheck disable=SC2329
cleanup() {
    # shellcheck disable=SC2317
    rm -rf "${workdir}" >/dev/null 2>&1 || true
}
trap 'cleanup' EXIT

# Fetch all switch configurations and stream into a named tar archive.

# mokerlink-backup derives the tar filename from the switch hostname and
# firmware version, which are not known until the SSH session completes.
# MOKERLINK_BACKUP_NAME_FILE is a sidecar path: mokerlink-backup writes the
# computed basename there so this script can rename the archive correctly
# without parsing the tar stream itself.
name_file="${workdir}/.backup-name"
MOKERLINK_BACKUP_NAME_FILE="${name_file}" \
    mokerlink-backup > "${workdir}/backup.tar.tmp"
backup_file=$(cat "${name_file}")
mv "${workdir}/backup.tar.tmp" "${workdir}/${backup_file}"
cd "${workdir}"

# Checksum the uncompressed tar before compression and encryption so the
# digest covers the exact archive contents, independent of the outer
# compression or encryption envelope.  Verification requires decrypting and
# decompressing first; see 'Verify a backup' in the README.
shafile="${backup_file}.sha256"
sha256sum "${backup_file}" > "${shafile}"
output_file="${backup_file}"

case "${COMPRESSION:=none}" in
    bzip | bzip2)
        info "compressing backup with bzip2: ${output_file}.bz2"
        bzip2 -9 --keep --quiet --stdout  <"${output_file}" >"${output_file}.bz2"
        output_file="${output_file}.bz2"
        ;;

    bzip3)
        info "compressing backup with bzip3: ${output_file}.bz3"
        bzip3 --batch --keep --stdout "${output_file}" >"${output_file}.bz3"
        output_file="${output_file}.bz3"
        ;;

    gz | gzip)
        info "compressing backup with gzip --best --no-name --quiet --synchronous: ${output_file}.gz"
        gzip --best --no-name --quiet --synchronous <"${output_file}" >"${output_file}.gz"
        output_file="${output_file}.gz"
        ;;

    lzo | lzop)
        info "compressing backup with lzop: ${output_file}.lzo"
        lzop <"${output_file}" >"${output_file}.lzo"
        output_file="${output_file}.lzo"
        ;;

    none)
        true
        ;;

    lzma | xz)
        info "compressing backup with lzma/xz --compress --extreme --quiet: ${output_file}.xz"
        xz --compress --extreme --quiet <"${output_file}" >"${output_file}.xz"
        output_file="${output_file}.xz"
        ;;

    pigz)
        info "compressing backup with pigz --best --no-name --quiet --synchronous: ${output_file}.pgz"
        pigz --best --no-name --quiet --synchronous <"${output_file}" >"${output_file}.pgz"
        output_file="${output_file}.pgz"
        ;;

    pixz)
        info "compressing backup with pixz -9 -t: ${output_file}.pxz"
        pixz -9 -t <"${output_file}" >"${output_file}.pxz"
        output_file="${output_file}.pxz"
        ;;

    zip)
        info "compressing backup with zip -q -9: ${output_file}.zip"
        zip -q -9 "${output_file}.zip" "${output_file}"
        output_file="${output_file}.zip"
        ;;

    *)
        error "unknown compression algorithm: '${COMPRESSION}'"
        ;;
esac

if "${gpg_encrypt}"; then
    info "encrypting backup with 'gpg' (GnuPG)"
    if [[ -n "${GPG_PASSPHRASE:=}" ]]; then
        # Pass passphrase via fd 3 to avoid exposing it in process list
        gpg "${gpg_args[@]}" --output "${output_file}.gpg" "${output_file}" 3<<<"${GPG_PASSPHRASE}"
    else
        # No passphrase, just use passphrase-file
        gpg "${gpg_args[@]}" --output "${output_file}.gpg" "${output_file}"
    fi
    output_file="${output_file}.gpg"
fi

info "downloaded '${backup_file}' to '${output_file}'"

awsargs=(--no-progress)
is_true "${dryrun}" && awsargs+=(--dryrun)

uri="s3://${bucket}/${output_file}"
shauri="s3://${bucket}/${shafile}"
info "upload backup: '${output_file}' → '${uri}'"
# `s3 mv` (not `cp`) deletes the local file after a successful upload,
# preventing unbounded accumulation of large archives in the workdir.
aws s3 mv "${awsargs[@]}" "${output_file}" "${uri}" 2>&1 | info || \
    error "aws s3 mv '${output_file}' failed"
info "upload checksum: '${shafile}' → '${shauri}'"
aws s3 mv "${awsargs[@]}" "${shafile}" "${shauri}" 2>&1 | info || \
    error "aws s3 mv '${shafile}' failed"
info "completed upload to S3 bucket '${bucket}'"
info "finish ${command}"
exit 0
