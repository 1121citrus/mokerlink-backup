#!/usr/bin/env bash

# Download a backup of a Mokerlink managed network switch.
#
# Copyright (C) 2025 James Hanlon [mailto:jim@hanlonsoftware.com]
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU Affero General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU Affero General Public License for more details.
#
# You should have received a copy of the GNU Affero General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.
#
# SYNOPSIS
#   mokerlink-backup [options]
#
# DESCRIPTION
#   Connects to a Mokerlink managed switch, downloads the selected
#   configurations (running, startup, and/or backup), and outputs them as
#   a tar archive (default) or as raw text to stdout.  All progress
#   messages go to stderr.
#
#   If MOKERLINK_BACKUP_NAME_FILE is set to a writable path, the computed
#   base filename for the tar archive is written there so callers can name
#   the output file appropriately (tar format only).
#
# OPTIONS
#   -?,--help              Display this help text
#   -v,--version           Display command version
#   -a,--all               Include all configurations (default)
#   -r,--running           Include running configuration
#      --no-running        Exclude running configuration
#   -s,--startup           Include startup configuration
#      --no-startup        Exclude startup configuration
#   -b,--backup            Include backup configuration
#      --no-backup         Exclude backup configuration
#   -f,--format FMT        Output format: 'raw' or 'tar'
#                          (env: MOKERLINK_FORMAT; default: 'tar')
#   -H,--host HOST         Switch hostname or IP (env: MOKERLINK_HOST)
#   -u,--user USER         SSH username (env: MOKERLINK_USER;
#                          default: remote-backup)
#   -p,--password PW       Password (env: MOKERLINK_PASSWORD)
#   -P,--password-file FILE
#                          Password file (env: MOKERLINK_PASSWORD_FILE;
#                          default: /run/secrets/mokerlink-password)
#
# ENVIRONMENT
#   MOKERLINK_HOST         Switch hostname or IP address
#   MOKERLINK_FORMAT       Output format: 'raw' or 'tar' (default: 'tar')
#   MOKERLINK_USER         SSH username (default: remote-backup)
#   MOKERLINK_PASSWORD     Switch login password
#   MOKERLINK_PASSWORD_FILE
#                          Path to password file
#                          (default: /run/secrets/mokerlink-password)
#   TAILSCALE_HOST         Fallback hostname when MOKERLINK_HOST is unset
#   MOKERLINK_BACKUP_NAME_FILE
#                          (tar format only) Path to write computed tar filename
#   DEBUG                  Enable debug tracing (default: false)
#   ENV                    Env-file path (default: ~/.env)
#
# EXAMPLES
#   # Download all configuration as a tarball:
#   mokerlink-backup --host switch --user backup-user \
#       --password-file secret-pw-file > switch-backup.tar
#
#   # Print the running switch configuration to stdout:
#   mokerlink-backup --host switch --user backup-user \
#       --password-file secret-pw-file --running --format raw

command=$(basename "${0}")
bindir=$(readlink -f "$(dirname "${0}")")
export PATH=${bindir}:${PATH}

# shellcheck disable=SC1091
source /usr/local/include/bash/common-functions

ENV=${ENV:-${HOME:-/root}/.env}
set -o errexit -o errtrace -o nounset -o pipefail
# shellcheck disable=SC1090
[[ -r "${ENV}" ]] && source "${ENV}"
is_true "${DEBUG:=false}" && set -o xtrace -o verbose

show_help() {
    cat <<'EOF'
Usage: mokerlink-backup [options]

Download a backup of a Mokerlink managed network switch.

Options:
  -?,--help              Display this help text
  -v,--version           Display command version
  -a,--all               Include all configurations (default)
  -r,--running           Include running configuration
     --no-running        Exclude running configuration
  -s,--startup           Include startup configuration
     --no-startup        Exclude startup configuration
  -b,--backup            Include backup configuration
     --no-backup         Exclude backup configuration
  -f,--format FMT        Output format: 'raw' or 'tar'
                         (env: MOKERLINK_FORMAT; default: 'tar')
  -H,--host HOST         Switch hostname or IP (env: MOKERLINK_HOST)
  -u,--user USER         SSH username (env: MOKERLINK_USER;
                         default: remote-backup)
  -p,--password PW       Password (env: MOKERLINK_PASSWORD)
  -P,--password-file FILE
                         Password file (env: MOKERLINK_PASSWORD_FILE;
                         default: /run/secrets/mokerlink-password)

Note: The switch is accessed via SSH using legacy algorithms required by the
Mokerlink firmware. See the README for security considerations.

Examples:
  # Download all configuration as a tarball:
  mokerlink-backup --host switch --user backup-user \
      --password-file secret-pw-file > switch-backup.tar

  # Print the running switch configuration to stdout:
  mokerlink-backup --host switch --user backup-user \
      --password-file secret-pw-file --running --format raw
EOF
}

show_version() {
    cat /usr/local/share/mokerlink-backup/version 2>/dev/null || echo "unknown"
}

# Defaults from environment
format="${MOKERLINK_FORMAT:-tar}"
host="${MOKERLINK_HOST:-${TAILSCALE_HOST:-}}"
user="${MOKERLINK_USER:-remote-backup}"
password="${MOKERLINK_PASSWORD:-}"
password_file="${MOKERLINK_PASSWORD_FILE:-/run/secrets/mokerlink-password}"

# Config selection state
has_positive=false
exclude_running=false
exclude_startup=false
exclude_backup=false
select_running=
select_startup=
select_backup=

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -\?|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -a|--all)
            has_positive=true
            select_running=true
            select_startup=true
            select_backup=true
            ;;
        -r|--running)
            has_positive=true
            select_running=true
            ;;
        --no-running)
            exclude_running=true
            ;;
        -s|--startup)
            has_positive=true
            select_startup=true
            ;;
        --no-startup)
            exclude_startup=true
            ;;
        -b|--backup)
            has_positive=true
            select_backup=true
            ;;
        --no-backup)
            exclude_backup=true
            ;;
        -f|--format)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            format="$2"
            shift
            ;;
        -H|--host)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            host="$2"
            shift
            ;;
        -u|--user)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            user="$2"
            shift
            ;;
        -p|--password)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            password="$2"
            shift
            ;;
        -P|--password-file)
            [[ $# -ge 2 ]] || error "option '${1}' requires an argument"
            password_file="$2"
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            error "unknown option: '${1}'"
            ;;
        *)
            error "unexpected argument: '${1}'"
            ;;
    esac
    shift
done

# If no positive selection was made, default to all
if ! "${has_positive}"; then
    select_running=true
    select_startup=true
    select_backup=true
fi

# Apply defaults (unset → false) then exclusions
select_running="${select_running:-false}"
select_startup="${select_startup:-false}"
select_backup="${select_backup:-false}"
if "${exclude_running}"; then select_running=false; fi
if "${exclude_startup}"; then select_startup=false; fi
if "${exclude_backup}"; then select_backup=false; fi

# Validate format
case "${format}" in
    raw|tar) ;;
    *) error "unknown format: '${format}' (expected 'raw' or 'tar')" ;;
esac

# Validate at least one config selected
if ! is_true "${select_running}" && ! is_true "${select_startup}" && ! is_true "${select_backup}"; then
    error "no configurations selected (all excluded)"
fi

# Resolve connection parameters
[[ -n "${host}" ]] || error 'need MOKERLINK_HOST or TAILSCALE_HOST (or --host / -H)'
if [[ -z "${password}" ]] && [[ -r "${password_file}" ]]; then
    password=$(cat "${password_file}")
fi
[[ -n "${password}" ]] || error 'need MOKERLINK_PASSWORD, --password, or --password-file (default: /run/secrets/mokerlink-password)'

info "begin ${command}"

timestamp=$(date +%Y%m%dT%H%M%S)

# Create a work directory -- to cleanup any debris
workdir=$(mktemp -d)
# shellcheck disable=SC2329
cleanup() {
    # shellcheck disable=SC2317
    rm -rf "${workdir}" >/dev/null 2>&1 || true
}
trap 'cleanup' EXIT
cd "${workdir}"

hostname=
version=
configs=()
is_true "${select_running}" && configs+=(running)
is_true "${select_startup}" && configs+=(startup)
is_true "${select_backup}" && configs+=(backup)

for config in "${configs[@]}"; do
    info "download '${config}' configuration from '${host}'"
    config_tmp=$(mktemp)
    # Pass password via env var rather than as a positional arg to avoid
    # exposing it in the process list (visible to ps(1)).
    MOKERLINK_PASSWORD="${password}" \
        bash "${bindir}/get-config" "${config}" "${host}" "${user}" >> "${config_tmp}"
    version=$(grep -m1 '^! System Version: ' "${config_tmp}" | cut -f2 -d: | sed 's/^[[:space:]]*//g' | sed 's/[[:space:]]*$//g' | sed 's/^v//g')
    is_true "${DEBUG}" && debug "version='$version'"
    [[ -n "${version}" ]] || error 'invalid Mokerlink configuration file - missing version'
    hostname=$(grep -m1 '^! System Name: ' "${config_tmp}" | cut -f2 -d: | sed 's/^[[:space:]]*//g' | sed 's/[[:space:]]*$//g')
    is_true "${DEBUG}" && debug "hostname='$hostname'"
    [[ -n "${hostname}" ]] || error 'invalid Mokerlink configuration file - missing hostname'
    if [[ "${format}" == "tar" ]]; then
        xml_file="${timestamp}-${hostname}-mokerlink-${version}-${config}-config-backup.xml"
        is_true "${DEBUG}" && debug "xml_file='$xml_file'"
        # Add header to pulled config file
        (echo 'SYSTEM CONFIG FILE ::= BEGIN' && \
         echo "! Backup: ${xml_file}" && \
         tail -n +2 "${config_tmp}") > "${xml_file}"
    else
        cat "${config_tmp}"
    fi
    info "completed download of '${config}' configuration from '${host}'"
done

if [[ "${format}" == "tar" ]]; then
    tar_name="${timestamp}-${hostname}-mokerlink-${version}-config-backup.tar"
    is_true "${DEBUG}" && debug "tar_name='${tar_name}'"
    if [[ -n "${MOKERLINK_BACKUP_NAME_FILE:=}" ]]; then
        printf '%s' "${tar_name}" > "${MOKERLINK_BACKUP_NAME_FILE}"
    fi
    info "streaming tar archive: ${tar_name}"
    tar -c -- *.xml
fi

info "finish ${command}"
