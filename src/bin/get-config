# along with this program.  If not, see <https://www.gnu.org/licenses/>.

bindir=$(readlink -f "$(dirname "${0}")")
export PATH=${bindir}:${PATH}

# shellcheck disable=SC1091
source /usr/local/include/bash/common-functions

set -o errexit -o errtrace -o nounset -o pipefail

expect_args=()
if is_true "${DEBUG:=false}"; then expect_args+=(-d); fi

function __show_config_raw__() {
    local config="${1:?Need configuration name}"
    local hostname="${2:?Need hostname}"
    local username="${3:?Need username}"
    local password="${4:?Need password}"
    # SSH_CONNECT_TIMEOUT: seconds to wait for the switch to respond.
    # Default 30s.  Set to 0 to disable (not recommended — the process will
    # hang indefinitely if the switch is unreachable).
    local timeout="${SSH_CONNECT_TIMEOUT:-30}"
    # Pass parameters as environment variables rather than positional args.
    # The heredoc delimiter is single-quoted so bash does not expand the
    # Tcl $env(...) references inside the script before expect reads them.
    EXPECT_CONFIG="${config}" \
    EXPECT_HOSTNAME="${hostname}" \
    EXPECT_USERNAME="${username}" \
    EXPECT_PASSWORD="${password}" \
    EXPECT_TIMEOUT="${timeout}" \
    /usr/bin/env expect "${expect_args[@]}" <<-'__END_OF_SCRIPT__'
log_user 0
# Increase match_max to accommodate large switch configs (ACLs, routing tables, port definitions).
# Default 2000 is too small for enterprise-scale Mikrotik switches.
set match_max 1000000
# Use the caller-supplied timeout; 0 means no timeout (not recommended).
set timeout $env(EXPECT_TIMEOUT)
set config $env(EXPECT_CONFIG)
set hostname $env(EXPECT_HOSTNAME)
set username $env(EXPECT_USERNAME)
set password $env(EXPECT_PASSWORD)
# -F /dev/null: ignore ~/.ssh/config to prevent local settings from
#   interfering.
# StrictHostKeyChecking=no + UserKnownHostsFile=/dev/null: the Mokerlink
#   firmware regenerates its host key on every factory reset; a known-hosts
#   file would block automation after any reset.
# +ssh-rsa: modern OpenSSH disables ssh-rsa by default; the Mokerlink
#   firmware does not support the newer key exchange algorithms.
spawn ssh -F /dev/null -T -o LogLevel=quiet -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null -o HostKeyAlgorithms=+ssh-rsa \
      -o PubkeyAcceptedAlgorithms=+ssh-rsa -l $username $hostname
# The firmware presents an application-layer login prompt over the SSH
# channel and does not support public-key authentication.
expect "Username: "
send -- "$username\r"
expect "Password: "
send -- "$password\r"
expect "# "
# Disable the firmware's built-in output pager so `show` commands stream
# their full output without --More-- interruptions.
send -- "terminal length 0\r"
expect "# "
send -- "show $config-config\r"
# log_user 1/0 brackets the config output: only the text between these two
# calls (the actual config body) reaches the caller's stdout; the surrounding
# session noise is suppressed.
log_user 1
expect "# "
log_user 0
# The firmware has two CLI levels: privileged exec (#) and user exec (>).
# First `exit` steps down from # to >; second `exit` closes the session.
# Use catch because some firmware builds close the SSH session automatically
# after the show command; in that case the exit sends are unnecessary and
# would otherwise raise "spawn id not open".
catch {send -- "exit\r"}
expect {
    "> " { catch {send -- "exit\r"} }
    eof  {}
    timeout {}
}
catch {expect eof}
__END_OF_SCRIPT__
}

config="${1:-running}"
config=$(echo "${config}" | tr '[:upper:]' '[:lower:]')
[[ "${config}" =~ ^(running|startup|backup)$ ]] || \
    error "unknown configuration: '${config}' -- expecting one of 'running', 'startup' or 'backup'"

host="${2:-${MOKERLINK_HOST:=${TAILSCALE_HOST:=}}}"
[[ -n "${host}" ]] || error 'need hostname, or set MOKERLINK_HOST or TAILSCALE_HOST environment variable'

user="${3:-${MOKERLINK_USER:=remote-backup}}"

# Password is intentionally NOT accepted as positional arg $4 to avoid
# exposing it in the process list (ps(1)).  Callers must use the environment
# variable MOKERLINK_PASSWORD or MOKERLINK_PASSWORD_FILE.
password=
if [[ -n "${MOKERLINK_PASSWORD:=}" ]]; then
    password="${MOKERLINK_PASSWORD}"
elif [[ -r "${MOKERLINK_PASSWORD_FILE:=/run/secrets/mokerlink-password}" ]]; then
    password=$(cat "${MOKERLINK_PASSWORD_FILE}")
fi
[[ -n "${password}" ]] || error 'need password, or set MOKERLINK_PASSWORD or MOKERLINK_PASSWORD_FILE (default: /run/secrets/mokerlink-password) environment variable'

# The firmware echoes the command twice before emitting the config body:
#   show running-config\r\n
#   show running-config\r\n
#   SYSTEM CONFIG FILE ::= BEGIN
#   ...
# Strip those two echo-back lines so only the config body reaches stdout.
__show_config_raw__ "${config}" "${host}" "${user}" "${password}" | tail -n +3
