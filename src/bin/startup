#!/usr/bin/env bash

# startup — container entrypoint: configure the environment and start crond.
#
# Copyright (C) 2025 James Hanlon [mailto:jim@hanlonsoftware.com]
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# SYNOPSIS
#   startup [options]
#
# OPTIONS
#   -?,--help     Display this help text
#   -v,--version  Display command version
#
# ENVIRONMENT
#   AWS_S3_BUCKET_NAME     S3 bucket name (required)
#   AWS_CONFIG_FILE        AWS config file (default: /run/secrets/aws-config)
#   AWS_DRYRUN             Set 'true' to skip real S3 writes (default: false)
#   COMPRESSION            Compression algorithm (default: none)
#   CRON_EXPRESSION        Cron schedule expression (default: @daily)
#   DEBUG                  Enable debug tracing (default: false)
#   GPG_CIPHER_ALGO        GPG cipher algorithm (default: aes256)
#   GPG_PASSPHRASE         GPG passphrase for symmetric encryption
#   GPG_PASSPHRASE_FILE    Path to GPG passphrase file
#                          (default: /run/secrets/gpg-passphrase)
#   MOKERLINK_HOST         Switch hostname or IP (required)
#   MOKERLINK_PASSWORD     Switch password
#   MOKERLINK_PASSWORD_FILE
#                          Path to switch password file
#                          (default: /run/secrets/mokerlink-password)
#   MOKERLINK_USER         SSH username (default: remote-backup)
#   TAILSCALE_HOST         Fallback hostname when MOKERLINK_HOST is unset
#   TZ                     Timezone (default: UTC)
#   BACKUP_SENTINEL_FILE   Path where `backup` writes its success sentinel;
#                          read by `healthcheck`
#                          (default: /tmp/mokerlink-backup-last-success)
#   BACKUP_MAX_AGE_SECONDS Maximum age in seconds before healthcheck reports
#                          unhealthy (default: 172800 = 2 days)

bindir=$(readlink -f "$(dirname "${0}")")
export PATH=${bindir}:${PATH}

# shellcheck disable=SC1091
source /usr/local/include/bash/common-functions

show_help() {
    sed -n '/^# SYNOPSIS/,/^[^#]/p' "$0" \
        | grep '^#' \
        | sed 's/^# \{0,1\}//'
}

show_version() {
    cat /usr/local/share/mokerlink-backup/version 2>/dev/null || echo "unknown"
}

# Handle --help and --version before service initialisation.
for _startup_arg in "$@"; do
    case "${_startup_arg}" in
        -\?|--help)    show_help;    exit 0 ;;
        -v|--version)  show_version; exit 0 ;;
        --)            break ;;
        -*)            error "unknown option: '${_startup_arg}'" ;;
    esac
done
unset _startup_arg

set -o errexit -o errtrace -o nounset -o pipefail
if is_true "${DEBUG:-false}"; then set -o xtrace -o verbose; fi

ENV=${ENV:-${HOME:-/root}/.env}
# shellcheck disable=SC1090
[[ -r "${ENV}" ]] && source "${ENV}"

# Write cronjob env to file, fill in sensible defaults, and read them back in
# helper to quote values containing single quotes
__quote() { printf '%s' "${1//\'/\'\"\'\"\'}"; }
install -m 0600 /dev/null "${ENV}"
cat <<EOF >"${ENV}"
export AWS_CONFIG_FILE='$(__quote "${AWS_CONFIG_FILE:-/run/secrets/aws-config}")'
export AWS_DRYRUN='$(__quote "${AWS_DRYRUN:-false}")'
export AWS_S3_BUCKET_NAME='$(__quote "${AWS_S3_BUCKET_NAME:?Need bucket}")'
export COMPRESSION='$(__quote "${COMPRESSION:-none}")'
export CRON_EXPRESSION='$(__quote "${CRON_EXPRESSION:-@daily}")'
export DEBUG='$(__quote "${DEBUG:-false}")'
export GPG_CIPHER_ALGO='$(__quote "${GPG_CIPHER_ALGO:-aes256}")'
export GPG_PASSPHRASE='$(__quote "${GPG_PASSPHRASE:-}")'
export GPG_PASSPHRASE_FILE='$(__quote "${GPG_PASSPHRASE_FILE:-/run/secrets/gpg-passphrase}")'
export MOKERLINK_HOST='$(__quote "${MOKERLINK_HOST:-}")'
export MOKERLINK_PASSWORD='$(__quote "${MOKERLINK_PASSWORD:-}")'
export MOKERLINK_PASSWORD_FILE='$(__quote "${MOKERLINK_PASSWORD_FILE:-/run/secrets/mokerlink-password}")'
export MOKERLINK_USER='$(__quote "${MOKERLINK_USER:-remote-backup}")'
export TAILSCALE_HOST='$(__quote "${TAILSCALE_HOST:-}")'
export TZ='$(__quote "${TZ:-UTC}")'
export BACKUP_SENTINEL_FILE='$(__quote "${BACKUP_SENTINEL_FILE:-/tmp/mokerlink-backup-last-success}")'
export BACKUP_MAX_AGE_SECONDS='$(__quote "${BACKUP_MAX_AGE_SECONDS:-172800}")'
EOF
clean-credentials() {
    sed -E 's/(GPG_PASSPHRASE|MOKERLINK_PASSWORD)='"'"'.*'"'"'$/\1='"'**REDACTED**'"'/' 
}
info "create env file ${ENV}"
clean-credentials < "${ENV}" | info
# shellcheck disable=SC1090
source "${ENV}"

# Add our cron entry, and direct stdout & stderr to Docker commands stdout
COMMAND=${COMMAND:-/usr/local/bin/backup}
info "installing cron.d entry: ${COMMAND}"
_crontab="/var/spool/cron/crontabs/$(id -un)"
echo "${CRON_EXPRESSION} ${COMMAND} 2>&1" > "${_crontab}"
chmod -c 0600 "${_crontab}" | info
info "crontab: $(cat "${_crontab}")"

info "handing the reins over to supercronic"
exec supercronic "${_crontab}"
